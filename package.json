{
  "name": "web-task-agent",
  "version": "0.4.0",
  "description": "Local-first, evidence-backed web research workflows with durable state and decision packages",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/cli.js",
  "bin": {
    "web-task-agent": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/demos/**/*.js",
    "dist/lib/**/*.js",
    "dist/packs/**/*.js",
    "dist/server/**/*.js",
    "dist/tasks/**/*.js",
    "dist/types/**/*.js",
    "dist/workflows/**/*.js",
    ".env.example",
    "install.sh",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "PRIVACY.md",
    "SUPPORT.md",
    "CODE_OF_CONDUCT.md",
    "RELEASE_CHECKLIST.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OthmaneBlial/web-task-agent.git"
  },
  "bugs": {
    "url": "https://github.com/OthmaneBlial/web-task-agent/issues"
  },
  "homepage": "https://othmaneblial.github.io/web-task-agent/",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "start": "npm run build && node dist/cli.js",
    "test": "npm run test:ci",
    "test:unit": "node --test $(find dist/tests -maxdepth 1 -name '*.test.js' | sort)",
    "test:integration": "node --test dist/tests/integration/*.test.js",
    "test:ci": "npm run typecheck && npm run build && npm run test:unit && npm run test:integration && npm run check:generated",
    "generate:workflows": "npm run build && node scripts/generate-workflow-examples.mjs",
    "generate:receipts": "npm run build && node scripts/generate-demo-receipts.mjs",
    "generate:docs": "node scripts/sync-docs.mjs",
    "check:links": "node scripts/check-markdown-links.mjs",
    "audit:secrets": "node scripts/audit-publication-secrets.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "release:check": "npm test && npm run audit:secrets && npm run audit:prod && npm pack --dry-run",
    "check:generated": "node scripts/generate-workflow-examples.mjs && node scripts/generate-demo-receipts.mjs && node scripts/sync-docs.mjs --check && npm run check:links && git diff --exit-code -- docs site examples/workflows examples/receipts",
    "lightpanda:start": "./scripts/start-lightpanda.sh start",
    "lightpanda:stop": "./scripts/start-lightpanda.sh stop",
    "lightpanda:update": "./scripts/start-lightpanda.sh update"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "chrome-remote-interface": "^0.34.0",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.33.0",
    "@types/node": "^25.4.0",
    "typescript": "^5.9.3"
  }
}
