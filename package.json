{
  "name": "web-task-agent",
  "version": "0.2.0",
  "description": "Local-first, evidence-backed web research workflows with durable state and decision packages",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/cli.js",
  "bin": {
    "web-task-agent": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/demos/**/*.js",
    "dist/lib/**/*.js",
    "dist/server/**/*.js",
    "dist/tasks/**/*.js",
    "dist/types/**/*.js",
    "dist/workflows/**/*.js",
    "install.sh",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OthmaneBlial/web-task-agent.git"
  },
  "bugs": {
    "url": "https://github.com/OthmaneBlial/web-task-agent/issues"
  },
  "homepage": "https://github.com/OthmaneBlial/web-task-agent#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "start": "npm run build && node dist/cli.js",
    "test": "npm run test:ci",
    "test:unit": "node --test $(find dist/tests -maxdepth 1 -name '*.test.js' | sort)",
    "test:integration": "node --test dist/tests/integration/*.test.js",
    "test:ci": "npm run build && npm run test:unit && npm run test:integration",
    "generate:workflows": "npm run build && node scripts/generate-workflow-examples.mjs",
    "lightpanda:start": "./scripts/start-lightpanda.sh start",
    "lightpanda:stop": "./scripts/start-lightpanda.sh stop",
    "lightpanda:update": "./scripts/start-lightpanda.sh update"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "chrome-remote-interface": "^0.34.0",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.33.0",
    "@types/node": "^25.4.0",
    "typescript": "^5.9.3"
  }
}
