{
  "name": "web-task-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Intelligent browser task automator using Chrome DevTools Protocol and Claude via a proxy endpoint",
  "type": "commonjs",
  "main": "dist/cli.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "start": "npm run build && node dist/cli.js",
    "lightpanda:start": "./scripts/start-lightpanda.sh start",
    "lightpanda:stop": "./scripts/start-lightpanda.sh stop",
    "lightpanda:update": "./scripts/start-lightpanda.sh update"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "chrome-remote-interface": "^0.34.0",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.33.0",
    "@types/node": "^25.4.0",
    "typescript": "^5.9.3"
  }
}