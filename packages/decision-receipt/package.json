{
  "name": "@othmaneblial/decision-receipt",
  "version": "0.1.0",
  "description": "Dependency-free Decision Receipt schema, validation, integrity verification, comparison, and rendering",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "decision-receipt": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": "./schema/decision-receipt.v1.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "schema/**/*.json",
    "conformance/**/*.json",
    "examples/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OthmaneBlial/web-task-agent.git",
    "directory": "packages/decision-receipt"
  },
  "homepage": "https://othmaneblial.github.io/web-task-agent/docs.html#page=decision-receipt-spec",
  "bugs": {
    "url": "https://github.com/OthmaneBlial/web-task-agent/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": false
}
