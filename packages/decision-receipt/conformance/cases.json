{
  "schemaVersion": 1,
  "specVersion": "1.0.0",
  "description": "Versioned Decision Receipt conformance recipes. Each mutation starts from the same valid minimal bundle.",
  "cases": [
    {
      "id": "valid-minimal",
      "mutation": "none",
      "expectedValid": true
    },
    {
      "id": "valid-date-only-collected-at",
      "mutation": "collected-at-date-only",
      "expectedValid": true
    },
    {
      "id": "invalid-generated-at-human-date",
      "mutation": "invalid-generated-at-human-date",
      "expectedValid": false,
      "expectedCode": "generated_at_invalid"
    },
    {
      "id": "invalid-generated-at-calendar-date",
      "mutation": "invalid-generated-at-calendar-date",
      "expectedValid": false,
      "expectedCode": "generated_at_invalid"
    },
    {
      "id": "invalid-collected-at-calendar-date",
      "mutation": "invalid-collected-at-calendar-date",
      "expectedValid": false,
      "expectedCode": "source_date_invalid"
    },
    {
      "id": "invalid-shape",
      "mutation": "remove-decision",
      "expectedValid": false,
      "expectedCode": "decision_missing"
    },
    {
      "id": "duplicate-source",
      "mutation": "duplicate-source",
      "expectedValid": false,
      "expectedCode": "source_id_duplicate"
    },
    {
      "id": "unsafe-path",
      "mutation": "unsafe-snapshot-path",
      "expectedValid": false,
      "expectedCode": "source_snapshot_path_unsafe"
    },
    {
      "id": "unsafe-path-trailing-slash",
      "mutation": "unsafe-snapshot-trailing-slash",
      "expectedValid": false,
      "expectedCode": "source_snapshot_path_unsafe"
    },
    {
      "id": "unknown-version",
      "mutation": "unknown-spec-version",
      "expectedValid": false,
      "expectedCode": "spec_version_unsupported"
    },
    {
      "id": "tampered",
      "mutation": "tamper-after-manifest",
      "expectedValid": false,
      "expectedCode": "integrity_hash_mismatch"
    },
    {
      "id": "manifest-receipt-omitted",
      "mutation": "remove-receipt-from-manifest",
      "expectedValid": false,
      "expectedCode": "manifest_receipt_missing"
    },
    {
      "id": "manifest-snapshot-omitted",
      "mutation": "remove-snapshot-from-manifest",
      "expectedValid": false,
      "expectedCode": "manifest_snapshot_missing"
    },
    {
      "id": "manifest-algorithm-invalid",
      "mutation": "invalid-manifest-algorithm",
      "expectedValid": false,
      "expectedCode": "manifest_contract_invalid"
    },
    {
      "id": "manifest-receipt-path-invalid",
      "mutation": "invalid-manifest-receipt-path",
      "expectedValid": false,
      "expectedCode": "manifest_contract_invalid"
    },
    {
      "id": "manifest-timestamp-invalid",
      "mutation": "invalid-manifest-timestamp",
      "expectedValid": false,
      "expectedCode": "manifest_contract_invalid"
    },
    {
      "id": "manifest-path-duplicated",
      "mutation": "duplicate-manifest-file",
      "expectedValid": false,
      "expectedCode": "manifest_path_duplicate"
    },
    {
      "id": "signature-mismatch",
      "mutation": "signature-mismatch",
      "expectedValid": false,
      "expectedCode": "signature_mismatch"
    }
  ]
}
