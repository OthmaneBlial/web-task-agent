# Copy this file to .env. It is safe to commit this template; never commit .env.

# Required for live LLM-backed research. Leave blank to use demos, previews,
# packs, scaffolds, and other no-network commands without a provider.
ANTHROPIC_API_KEY=

# Optional Anthropic-compatible endpoint configuration. Keep these blank to use
# the provider defaults, or set all three for a compatible local/provider proxy.
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_TIMEOUT_MS=90000

# Local-only state. This path is ignored by Git by default.
WEB_TASK_AGENT_DB_PATH=.data/web-task-agent.sqlite

# Local browser DevTools Protocol endpoint. It must stay on the operator's
# machine; the CLI never needs an authenticated browser profile.
CDP_PORT=9222
LIGHTPANDA_DISABLE_TELEMETRY=true

# Optional source-acquisition boundaries. An allowlist refuses every other
# domain. Leave it blank for the default public-web policy.
WEB_TASK_AGENT_ALLOWED_DOMAINS=
WEB_TASK_AGENT_BLOCKED_DOMAINS=
WEB_TASK_AGENT_REVIEW_DOMAINS=
WEB_TASK_AGENT_DOMAIN_MIN_DELAY_MS=1200
WEB_TASK_AGENT_DOMAIN_MAX_REQUESTS=12
WEB_TASK_AGENT_USER_AGENT=web-task-agent (+https://github.com/OthmaneBlial/web-task-agent)
